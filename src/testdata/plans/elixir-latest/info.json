    },
    "erlang": {
      "name": "erlang",
      "requestedVersion": "29.1.2",
      "resolvedVersion": "29.1.2",
      "source": "mise.toml"
    }
  },
  "metadata": {
    "providers": "Elixir"
  },
  "detectedProviders": [
    "Elixir"
  ],
  "logs": [
    {
      "Level": "info",
