{
  "$schema": "https://schema.railpack.com",
  "deploy": {
    "base": {
      "image": "ghcr.io/railwayapp/railpack-runtime:mise-2026.10.14"
    },
    "inputs": [
      {
        "include": [
          "/mise/shims",
          "/mise/installs",
          "/usr/local/bin/mise",
          "/etc/mise/config.toml",
          "/root/.local/state/mise"
        ],
        "step": "packages:mise:runtime"
      },
      {
        "include": [
          "build/erlang-shipment/."
        ],
        "step": "build"
      }
    ],
    "startCommand": "./build/erlang-shipment/entrypoint.sh run",
    "variables": {
      "RAILPACK_VERSION": "0.43.0"
    }
  },
  "steps": [
    {
      "assets": {
        "generated-mise-toml": "[tools]\n  erlang = \"29.1.2\"\n  gleam = \"1.19.2\"\n\n[settings]\n  idiomatic_version_file_enable_tools = [\"python\", \"node\", \"ruby\", \"elixir\", \"go\", \"java\", \"yarn\", \"pnpm\", \"bun\", \"deno\", \"dotnet\", \"rust\"]\n  minimum_release_age = \"14d\"\n  paranoid = true\n  trusted_config_paths = [\"/app\"]\n  [settings.node]\n    verify = false\n"
      },
      "commands": [
        {
          "path": "/mise/shims"
        },
        {
          "customName": "create mise config",
          "name": "generated-mise-toml",
          "path": "/etc/mise/config.toml"
        },
        {
          "cmd": "mise install",
          "customName": "install mise packages: erlang, gleam"
        }
      ],
      "inputs": [
        {
          "image": "ghcr.io/railwayapp/railpack-builder:mise-2026.10.14"
        }
      ],
      "name": "packages:mise",
      "variables": {
        "MISE_CACHE_DIR": "/mise/cache",
        "MISE_CONFIG_DIR": "/mise",
        "MISE_DATA_DIR": "/mise",
        "MISE_INSTALLS_DIR": "/mise/installs",
        "MISE_SHIMS_DIR": "/mise/shims"
      }
    },
    {
      "commands": [
        {
          "cmd": "gleam export erlang-shipment"
        }
      ],
      "inputs": [
        {
          "step": "packages:mise"
        },
        {
          "include": [
            "."
          ],
          "local": true
        }
      ],
      "name": "build",
      "secrets": [
        "*"
      ]
    },
    {
      "assets": {
        "generated-mise-toml": "[tools]\n  erlang = \"29.1.2\"\n\n[settings]\n  idiomatic_version_file_enable_tools = [\"python\", \"node\", \"ruby\", \"elixir\", \"go\", \"java\", \"yarn\", \"pnpm\", \"bun\", \"deno\", \"dotnet\", \"rust\"]\n  minimum_release_age = \"14d\"\n  paranoid = true\n  trusted_config_paths = [\"/app\"]\n  [settings.node]\n    verify = false\n"
      },
      "commands": [
        {
          "path": "/mise/shims"
        },
        {
          "customName": "create mise config",
          "name": "generated-mise-toml",
          "path": "/etc/mise/config.toml"
        },
        {
          "cmd": "mise install",
          "customName": "install mise packages: erlang"
        }
      ],
      "inputs": [
        {
          "image": "ghcr.io/railwayapp/railpack-builder:mise-2026.10.14"
        }
      ],
      "name": "packages:mise:runtime",
      "variables": {
        "MISE_CACHE_DIR": "/mise/cache",
        "MISE_CONFIG_DIR": "/mise",
        "MISE_DATA_DIR": "/mise",
        "MISE_INSTALLS_DIR": "/mise/installs",
        "MISE_SHIMS_DIR": "/mise/shims"
      }
    }
  ]
}