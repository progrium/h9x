{
  "railpackVersion": "0.43.0",
  "plan": {
    "steps": [
      {
        "name": "packages:mise",
        "inputs": [
          {
            "image": "ghcr.io/railwayapp/railpack-builder:mise-2026.10.14"
          }
        ],
        "commands": [
          {
            "path": "/mise/shims"
          },
          {
            "path": "/etc/mise/config.toml",
            "name": "generated-mise-toml",
            "customName": "create mise config"
          },
          {
            "cmd": "mise install",
            "customName": "install mise packages: bun, node"
          }
        ],
        "assets": {
          "generated-mise-toml": "[tools]\n  bun = \"1.4.4\"\n  node = \"24.22.3\"\n\n[settings]\n  idiomatic_version_file_enable_tools = [\"python\", \"node\", \"ruby\", \"elixir\", \"go\", \"java\", \"yarn\", \"pnpm\", \"bun\", \"deno\", \"dotnet\", \"rust\"]\n  minimum_release_age = \"14d\"\n  paranoid = true\n  trusted_config_paths = [\"/app\"]\n  [settings.node]\n    verify = false\n"
        },
        "variables": {
          "MISE_CACHE_DIR": "/mise/cache",
          "MISE_CONFIG_DIR": "/mise",
          "MISE_DATA_DIR": "/mise",
          "MISE_INSTALLS_DIR": "/mise/installs",
          "MISE_SHIMS_DIR": "/mise/shims"
        }
      },
      {
        "name": "install",
        "inputs": [
          {
            "step": "packages:mise"
          }
        ],
        "commands": [
          {
            "path": "/app/node_modules/.bin"
          },
          {
            "cmd": "mkdir -p /app/node_modules/.cache"
          },
          {
            "src": "bun.lockb",
            "dest": "bun.lockb"
          },
          {
            "src": "package.json",
            "dest": "package.json"
          },
          {
            "cmd": "bun install --frozen-lockfile"
          }
        ],
        "variables": {
          "BUN_INSTALL_GLOBAL_STORE": "0",
          "CI": "true",
          "NODE_ENV": "production",
          "NPM_CONFIG_FETCH_RETRIES": "5",
          "NPM_CONFIG_FUND": "false",
          "NPM_CONFIG_PRODUCTION": "false",
          "NPM_CONFIG_UPDATE_NOTIFIER": "false"
        },
        "caches": [
          "bun-install"
        ]
      },
      {
        "name": "build",
        "inputs": [
          {
            "step": "install"
          },
          {
            "local": true,
            "include": [
              "."
            ]
          }
        ],
        "commands": [
          {
            "cmd": "bun run build"
          }
        ],
        "secrets": [
          "*"
        ],
        "caches": [
          "node-modules"
        ]
      },
      {
        "name": "packages:apt:runtime",
        "inputs": [
          {
            "image": "ghcr.io/railwayapp/railpack-runtime:mise-2026.10.14"
          }
        ],
        "commands": [
          {
            "cmd": "sh -c 'apt-get update \u0026\u0026 apt-get install -y libatomic1'",
            "customName": "install apt packages: libatomic1"
          }
        ],
        "caches": [
          "apt",
          "apt-lists"
        ]
      }
    ],
    "caches": {
      "apt": {
        "directory": "/var/cache/apt",
        "type": "locked"
      },
      "apt-lists": {
        "directory": "/var/lib/apt/lists",
        "type": "locked"
      },
      "bun-install": {
        "directory": "/root/.bun/install/cache",
        "type": "shared"
      },
      "node-modules": {
        "directory": "/app/node_modules/.cache",
        "type": "shared"
      }
    },
    "deploy": {
      "base": {
        "step": "packages:apt:runtime"
      },
      "inputs": [
        {
          "step": "packages:mise",
          "include": [
            "/mise/shims",
            "/mise/installs",
            "/usr/local/bin/mise",
            "/etc/mise/config.toml",
            "/root/.local/state/mise"
          ]
        },
        {
          "step": "build",
          "include": [
            "/app/node_modules"
          ]
        },
        {
          "step": "build",
          "include": [
            "/root/.cache",
            "."
          ],
          "exclude": [
            "node_modules",
            ".yarn"
          ]
        }
      ],
      "startCommand": "bun index.ts",
      "variables": {
        "BUN_INSTALL_GLOBAL_STORE": "0",
        "CI": "true",
        "NODE_ENV": "production",
        "NPM_CONFIG_FETCH_RETRIES": "5",
        "NPM_CONFIG_FUND": "false",
        "NPM_CONFIG_PRODUCTION": "false",
        "NPM_CONFIG_UPDATE_NOTIFIER": "false",
        "RAILPACK_VERSION": "0.43.0"
      }
    },
    "exclude": [
      "node_modules"
    ]
  },
  "resolvedPackages": {
    "bun": {
      "name": "bun",
      "requestedVersion": "latest",
      "resolvedVersion": "1.4.4",
      "source": "railpack default"
    },
    "node": {
      "name": "node",
      "requestedVersion": "lts",
      "resolvedVersion": "24.22.3",
      "source": "railpack default"
    }
  },
  "metadata": {
    "nodePackageManager": "bun",
    "nodeRuntime": "bun",
    "providers": "node"
  },
  "detectedProviders": [
    "node"
  ],
  "logs": [
    {
      "Level": "info",
      "Msg": "Detected Node",
      "DocsPath": ""
    },
    {
      "Level": "info",
      "Msg": "Using bun package manager",
      "DocsPath": ""
    },
    {
      "Level": "info",
      "Msg": "Bun runtime detected",
      "DocsPath": ""
    },
    {
      "Level": "suggestion",
      "Msg": "Applying default exclude patterns: `node_modules`. Add a `.dockerignore` to customize",
      "DocsPath": "/config/excluding-files"
    }
  ],
  "success": true
}
